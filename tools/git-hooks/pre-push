#!/usr/bin/env bash
# Pre-push hook (Bundle B, DECISIONS E37): the private-data guard and the JS check run on exactly what is being
# pushed, before GitHub (and Pages) ever sees it. CI runs the same two after the push; this one runs first.
# Every commit in the push is checked with the guard (a figure added in one commit and removed in the next is
# still in the public history); the tip also gets the JS check. Uses the newest guard: the one being pushed.
# Switched on once per clone (tools/dev/README.md):   git config core.hooksPath tools/git-hooks
# Never skip it with --no-verify.
set -uo pipefail
zero=0000000000000000000000000000000000000000
scratch="$(mktemp -d)"; trap 'git worktree remove --force "$scratch/tree" >/dev/null 2>&1; rm -rf "$scratch"' EXIT
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                       # deleting a branch: nothing to check
  if [ "$remote_sha" = "$zero" ]; then range=("$local_sha" --not --remotes); else range=("$remote_sha..$local_sha"); fi
  commits=$(git rev-list --reverse "${range[@]}")
  [ -n "$commits" ] || continue
  # the guard and its allow-list as of the tip being pushed
  mkdir -p "$scratch/guard"
  git show "$local_sha:tools/ci/private-data-guard.sh" > "$scratch/guard/private-data-guard.sh" || { echo "✗ pre-push: no guard in $local_sha"; exit 1; }
  git show "$local_sha:tools/ci/private-data-allow.txt" > "$scratch/guard/private-data-allow.txt" 2>/dev/null || true
  chmod +x "$scratch/guard/private-data-guard.sh"
  [ -d "$scratch/tree" ] || git worktree add --detach -q "$scratch/tree" "$local_sha" || { echo "✗ pre-push: couldn't check out $local_sha"; exit 1; }
  n=0
  for c in $commits; do
    git -C "$scratch/tree" checkout -q --detach "$c" || { echo "✗ pre-push: couldn't check out $c"; exit 1; }
    if ! out=$(GUARD_ROOT="$scratch/tree" "$scratch/guard/private-data-guard.sh" 2>&1); then
      echo "✗ private-data guard fails on $(git log -1 --format='%h %s' "$c")"; echo "$out"; fail=1
    fi
    n=$((n + 1))
  done
  git -C "$scratch/tree" checkout -q --detach "$local_sha"
  if ! out=$(cd "$scratch/tree" && node tools/ci/check-js.mjs 2>&1); then
    echo "✗ JavaScript check fails on $(git log -1 --format='%h %s' "$local_sha")"; echo "$out"; fail=1
  fi
  [ $fail -eq 0 ] && echo "✓ pre-push: $n commit(s) to ${remote_ref#refs/heads/} pass the private-data guard; the JS check passes"
done
if [ $fail -ne 0 ]; then
  echo "✗ push stopped — nothing was sent. Fix it in a new commit (or amend before pushing), then push again."
  echo "  If a private figure is in an earlier commit of this push, rewrite those local commits first (ask Claude)."
  exit 1
fi
exit 0
